# The scheme selects the engine: postgres:// or sqlite:
DATABASE_URL=postgres://threadmark:threadmark@localhost:5434/threadmark
# Single-node alternative, needing no database service:
# DATABASE_URL=sqlite://./data/threadmark.db
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_SYNCHRONOUS=full   # full survives power loss; normal is faster
LISTEN_ADDR=0.0.0.0:8090
PUBLIC_URL=http://localhost:8090
THREADMARK_SECRET=replace-with-at-least-32-random-characters
CAPABILITY_TTL_SECONDS=900
AUTH_MODE=trusted_headers
# Production JWT mode also requires:
# AUTH_ISSUER=https://auth.example.com
# AUTH_AUDIENCE=threadmark-api
# AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
AUTH_MAX_OWNER_TOKEN_SECONDS=300
FILE_MAX_MB=32
# s3 or filesystem. Filesystem storage has no presigning, so it supports
# neither direct browser upload nor presigned download.
BLOB_BACKEND=s3
# BLOB_BACKEND=filesystem
# BLOB_DIR=./data/blobs
S3_ENDPOINT=http://localhost:9010
S3_PUBLIC_URL=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=threadmark
# Bucket versioning must be Enabled when DIRECT_UPLOAD_ENABLED=true, and is
# recommended otherwise so deleting a file removes every recoverable copy.
# The runtime role always needs s3:GetBucketVersioning.
S3_ACCESS_KEY_ID=threadmark
S3_SECRET_ACCESS_KEY=threadmark-secret
S3_FORCE_PATH_STYLE=true
DIRECT_UPLOAD_ENABLED=false
FILE_UPLOAD_URL_TTL_SECONDS=60
FILE_UPLOAD_SESSION_TTL_SECONDS=3600
RUST_LOG=threadmark=info,tower_http=info
